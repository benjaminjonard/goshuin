<div {{ attributes.defaults({class: 'grid gap-1.5'}) }}>
    <input type="hidden" name="{{ name }}" value="{{ selected }}">

    {% if this.chosen %}
        <div class="flex items-center gap-2.5 rounded-xl border border-line-2 bg-tile-2 px-3.5 py-2.5">
            <span class="min-w-0 flex-auto">
                <span class="block truncate text-[15px] text-fg">{{ this.chosen.romanizedName }}</span>
                {% if this.chosen.japaneseName or this.chosen.locality %}
                    <span class="block truncate text-xs text-fg-3"><span class="font-jp">{{ this.chosen.japaneseName }}</span>{{ this.chosen.japaneseName and this.chosen.locality ? ' · ' }}{{ this.chosen.locality }}</span>
                {% endif %}
            </span>
            <button type="button" class="cursor-pointer rounded-lg px-2 py-1 text-xs font-semibold text-fg-2 hover:text-fg" data-action="live#action" data-live-action-param="clear">
                {{ 'label.change'|trans }}
            </button>
        </div>
    {% elseif creating %}
        <div class="grid gap-3.5 rounded-2xl border border-line bg-tile-2 p-4">
            {% if this.geocoderAvailable %}
                <div class="grid gap-1.5">
                    <label class="text-[12.5px] font-semibold text-fg-2" for="{{ id }}-address">{{ 'label.address_search'|trans }}</label>
                    <input type="text" id="{{ id }}-address" data-model="debounce(1000)|address" value="{{ address }}"
                           class="w-full rounded-xl border border-line-2 bg-tile px-3.5 py-2.5 text-[15px] text-fg focus-visible:border-accent"
                           placeholder="{{ 'label.address_placeholder'|trans }}">

                    <p class="hidden overflow-hidden rounded-xl border border-line bg-tile px-3.5 py-2.5 text-[13px] text-fg-3"
                       data-loading="model(address)|removeClass(hidden)" role="status">
                        <span class="mr-2 inline-block size-4 animate-spin rounded-full border-2 border-line-2 border-t-accent align-[-3px]" aria-hidden="true"></span>
                        {{ 'label.searching'|trans }}
                    </p>

                    {% if this.searchable %}
                        <div class="grid overflow-hidden rounded-xl border border-line bg-tile" role="listbox" data-loading="model(address)|addClass(hidden)">
                            <span class="grid">
                            {% if this.failed %}
                                <p class="flex items-start gap-2.5 px-3.5 py-2.5 text-[13px] text-accent-text" role="alert">
                                    {{ include('App/_partials/_icon.html.twig', {name: 'info', small: true, class: 'mt-px'}) }}
                                    {{ 'error.geocoder'|trans }}
                                </p>
                            {% elseif this.places is empty %}
                                <p class="px-3.5 py-2.5 text-[13px] text-fg-3">{{ 'label.no_result'|trans }}</p>
                            {% else %}
                            {% for place in this.places %}
                                <button type="button" role="option" aria-selected="false"
                                        class="grid cursor-pointer gap-0.5 px-3.5 py-2.5 text-left hover:bg-tile-2"
                                        data-action="live#action"
                                        data-live-action-param="usePlace"
                                        data-live-place-name-param="{{ place.name }}"
                                        data-live-japanese-name-param="{{ place.japaneseName }}"
                                        data-live-locality-param="{{ place.locality }}"
                                        data-live-prefecture-param="{{ place.prefecture }}"
                                        data-live-address-param="{{ place.address }}"
                                        data-live-latitude-param="{{ place.latitude }}"
                                        data-live-longitude-param="{{ place.longitude }}">
                                    <span class="truncate text-sm font-semibold text-fg">{{ place.name }}</span>
                                    <span class="truncate text-xs text-fg-3"><span class="font-jp">{{ place.japaneseName }}</span>{{ place.japaneseName and place.address ? ' · ' }}{{ place.address }}</span>
                                </button>
                            {% endfor %}
                            {% endif %}
                            </span>
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            <div class="grid gap-1.5">
                <label class="text-[12.5px] font-semibold text-fg-2" for="{{ id }}-new-romanized">{{ 'label.romanized_name'|trans }}</label>
                <input type="text" id="{{ id }}-new-romanized" data-model="debounce(300)|newRomanizedName" value="{{ newRomanizedName }}"
                       class="w-full rounded-xl border border-line-2 bg-tile px-3.5 py-2.5 text-[15px] text-fg focus-visible:border-accent">
                {% if this.getError('newRomanizedName') %}
                    <p class="text-xs font-semibold text-accent-text" role="alert">{{ this.getError('newRomanizedName').message }}</p>
                {% endif %}
            </div>

            {% if this.duplicates is not empty %}
                <p class="flex items-start gap-2.5 rounded-xl border border-accent-line bg-accent-soft px-3.5 py-3 text-[12.5px] leading-relaxed text-accent-text" role="alert">
                    {{ include('App/_partials/_icon.html.twig', {name: 'info', small: true, class: 'mt-px'}) }}
                    <span>{{ 'message.location_duplicate'|trans({'%count%': this.duplicates|length}) }}</span>
                </p>
            {% endif %}

            <div class="grid gap-3.5 sm:grid-cols-2">
                <div class="grid gap-1.5">
                    <label class="text-[12.5px] font-semibold text-fg-2" for="{{ id }}-new-japanese">{{ 'label.japanese_name'|trans }}</label>
                    <input type="text" id="{{ id }}-new-japanese" data-model="norender|newJapaneseName" value="{{ newJapaneseName }}"
                           class="w-full rounded-xl border border-line-2 bg-tile px-3.5 py-2.5 font-jp text-[15px] text-fg focus-visible:border-accent">
                </div>
                <div class="grid gap-1.5">
                    <label class="text-[12.5px] font-semibold text-fg-2" for="{{ id }}-new-locality">{{ 'label.locality'|trans }}</label>
                    <input type="text" id="{{ id }}-new-locality" data-model="norender|newLocality" value="{{ newLocality }}"
                           class="w-full rounded-xl border border-line-2 bg-tile px-3.5 py-2.5 text-[15px] text-fg focus-visible:border-accent">
                </div>
            </div>

            <div class="grid gap-3.5 sm:grid-cols-2">
                <div class="grid gap-1.5">
                    <label class="text-[12.5px] font-semibold text-fg-2" for="{{ id }}-new-prefecture">{{ 'label.prefecture'|trans }}</label>
                    <input type="text" id="{{ id }}-new-prefecture" data-model="norender|newPrefecture" value="{{ newPrefecture }}"
                           class="w-full rounded-xl border border-line-2 bg-tile px-3.5 py-2.5 text-[15px] text-fg focus-visible:border-accent">
                </div>
            </div>

            <div class="grid gap-1.5">
                <label class="text-[12.5px] font-semibold text-fg-2" for="{{ id }}-new-address">{{ 'label.address'|trans }}</label>
                <input type="text" id="{{ id }}-new-address" data-model="norender|newAddress" value="{{ newAddress }}"
                       class="w-full rounded-xl border border-line-2 bg-tile px-3.5 py-2.5 text-[15px] text-fg focus-visible:border-accent">
            </div>

            <div class="grid gap-1.5">
                <label class="text-[12.5px] font-semibold text-fg-2" for="{{ id }}-new-type">{{ 'label.location_type'|trans }}</label>
                <select id="{{ id }}-new-type" data-model="norender|newType"
                        class="w-full cursor-pointer rounded-xl border border-line-2 bg-tile px-3.5 py-2.5 text-[15px] text-fg focus-visible:border-accent">
                    <option value="">{{ 'label.unrecorded'|trans }}</option>
                    {% for value, label in this.types %}
                        <option value="{{ value }}" {{ newType == value ? 'selected' : '' }}>{{ label|trans }}</option>
                    {% endfor %}
                </select>
            </div>

            <div data-controller="map"
                 data-map-mode-value="picker"
                 data-map-tiles-value="{{ map_tiles }}"
                 data-map-attribution-value="{{ map_attribution }}"
                 data-map-latitude-value="{{ newLatitude|default('0') }}"
                 data-map-longitude-value="{{ newLongitude|default('0') }}"
                 class="grid gap-3.5">
                <div class="grid gap-3.5 sm:grid-cols-2">
                    <div class="grid gap-1.5">
                        <label class="text-[12.5px] font-semibold text-fg-2" for="{{ id }}-new-lat">{{ 'label.latitude'|trans }}</label>
                        <input type="text" id="{{ id }}-new-lat" data-model="norender|newLatitude" data-map-target="latitude" value="{{ newLatitude }}" inputmode="decimal"
                               class="w-full rounded-xl border border-line-2 bg-tile px-3.5 py-2.5 text-[15px] tabular-nums text-fg focus-visible:border-accent">
                    </div>
                    <div class="grid gap-1.5">
                        <label class="text-[12.5px] font-semibold text-fg-2" for="{{ id }}-new-lng">{{ 'label.longitude'|trans }}</label>
                        <input type="text" id="{{ id }}-new-lng" data-model="norender|newLongitude" data-map-target="longitude" value="{{ newLongitude }}" inputmode="decimal"
                               class="w-full rounded-xl border border-line-2 bg-tile px-3.5 py-2.5 text-[15px] tabular-nums text-fg focus-visible:border-accent">
                    </div>
                </div>

                <div class="h-[260px] overflow-hidden rounded-2xl border border-line" data-map-target="canvas" data-live-ignore aria-label="{{ 'label.place_on_map'|trans }}"></div>
                <p class="text-xs text-fg-3">{{ 'label.place_on_map'|trans }}</p>
            </div>

            <div class="grid gap-1.5">
                <label class="text-[12.5px] font-semibold text-fg-2" for="{{ id }}-new-notes">{{ 'label.notes'|trans }}</label>
                <textarea id="{{ id }}-new-notes" data-model="norender|newNotes" rows="2"
                          class="w-full resize-y rounded-xl border border-line-2 bg-tile px-3.5 py-2.5 text-[15px] leading-relaxed text-fg focus-visible:border-accent">{{ newNotes }}</textarea>
            </div>

            <div class="flex justify-end gap-2.5">
                <button type="button" class="cursor-pointer rounded-xl border border-line-2 bg-tile px-[15px] py-[9px] text-[13.5px] font-semibold text-fg hover:border-fg-3"
                        data-action="live#action" data-live-action-param="cancelCreating">{{ 'label.cancel'|trans }}</button>
                <button type="button" class="cursor-pointer rounded-xl border border-accent bg-accent px-[15px] py-[9px] text-[13.5px] font-semibold text-white hover:brightness-105 dark:text-[#24100d]"
                        data-action="live#action" data-live-action-param="create">{{ 'label.create_location'|trans }}</button>
            </div>
        </div>
    {% else %}
        <input type="text"
               id="{{ id }}"
               class="w-full rounded-xl border border-line-2 bg-tile-2 px-3.5 py-2.5 text-[15px] text-fg hover:border-fg-3 focus-visible:border-accent focus-visible:bg-tile"
               role="combobox"
               autocomplete="off"
               aria-expanded="{{ this.results is not empty or this.creatable ? 'true' : 'false' }}"
               aria-controls="{{ id }}-listbox"
               data-model="debounce(200)|term"
               placeholder="{{ 'label.location_search'|trans }}">

        {% if this.results is not empty or this.creatable %}
            <div class="grid overflow-hidden rounded-xl border border-line bg-tile shadow-lift" id="{{ id }}-listbox" role="listbox">
                {% for location in this.results %}
                    <button type="button" role="option" aria-selected="false"
                            class="flex cursor-pointer items-center gap-2.5 px-3.5 py-2.5 text-left hover:bg-tile-2"
                            data-action="live#action" data-live-action-param="choose" data-live-location-param="{{ location.id }}">
                        <span class="min-w-0 flex-auto">
                            <span class="block truncate text-sm font-semibold text-fg">{{ location.romanizedName }}</span>
                            {% if location.japaneseName or location.locality %}
                                <span class="block truncate text-xs text-fg-3"><span class="font-jp">{{ location.japaneseName }}</span>{{ location.japaneseName and location.locality ? ' · ' }}{{ location.locality }}</span>
                            {% endif %}
                        </span>
                    </button>
                {% endfor %}

                {% if this.results is empty %}
                    <p class="px-3.5 py-2.5 text-[13px] text-fg-3">{{ 'label.no_result'|trans }}</p>
                {% endif %}

                {% if this.creatable %}
                    <button type="button" role="option" aria-selected="false"
                            class="flex cursor-pointer items-center gap-2.5 border-t border-line px-3.5 py-2.5 text-left text-[13.5px] font-semibold text-accent-text hover:bg-tile-2"
                            data-action="live#action" data-live-action-param="startCreating">
                        {{ include('App/_partials/_icon.html.twig', {name: 'plus', small: true}) }}
                        {{ 'label.create_named_location'|trans({'%name%': this.creatable}) }}
                    </button>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
</div>
