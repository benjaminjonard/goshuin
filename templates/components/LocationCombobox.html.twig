<div {{ attributes.defaults({class: 'grid gap-1.5'}) }}>
    <input type="hidden" name="{{ name }}" value="{{ selected }}">

    {% if this.chosen %}
        <div class="flex items-center gap-2.5 rounded-xl border border-line-2 bg-tile-2 px-3.5 py-2.5">
            <span class="min-w-0 flex-auto">
                <span class="block truncate text-[15px] text-fg">{{ this.chosen.romanizedName }}</span>
                {% if this.chosen.japaneseName or this.chosen.locality %}
                    <span class="block truncate text-xs text-fg-3"><span class="font-jp">{{ this.chosen.japaneseName }}</span>{{ this.chosen.japaneseName and this.chosen.locality ? ' · ' }}{{ this.chosen.locality }}</span>
                {% endif %}
            </span>
            <button type="button" class="cursor-pointer rounded-lg px-2 py-1 text-xs font-semibold text-fg-2 hover:text-fg" data-action="live#action" data-live-action-param="clear">
                {{ 'label.change'|trans }}
            </button>
        </div>
    {% elseif creating %}
        <div class="grid gap-3.5 rounded-2xl border border-line bg-tile-2 p-4">
            {{ component('LocationForm', {named: named, id: id ~ '-new'}) }}
        </div>
    {% else %}
        <input type="text"
               id="{{ id }}"
               class="w-full rounded-xl border border-line-2 bg-tile-2 px-3.5 py-2.5 text-[15px] text-fg hover:border-fg-3 focus-visible:border-accent focus-visible:bg-tile"
               role="combobox"
               autocomplete="off"
               aria-expanded="{{ this.results is not empty or this.creatable ? 'true' : 'false' }}"
               aria-controls="{{ id }}-listbox"
               data-model="debounce(200)|term"
               placeholder="{{ 'label.location_search'|trans }}">

        {% if this.results is not empty or this.creatable %}
            <div class="grid overflow-hidden rounded-xl border border-line bg-tile shadow-lift" id="{{ id }}-listbox" role="listbox">
                {% for location in this.results %}
                    <button type="button" role="option" aria-selected="false"
                            class="flex cursor-pointer items-center gap-2.5 px-3.5 py-2.5 text-left hover:bg-tile-2"
                            data-action="live#action" data-live-action-param="choose" data-live-location-param="{{ location.id }}">
                        <span class="min-w-0 flex-auto">
                            <span class="block truncate text-sm font-semibold text-fg">{{ location.romanizedName }}</span>
                            {% if location.japaneseName or location.locality %}
                                <span class="block truncate text-xs text-fg-3"><span class="font-jp">{{ location.japaneseName }}</span>{{ location.japaneseName and location.locality ? ' · ' }}{{ location.locality }}</span>
                            {% endif %}
                        </span>
                    </button>
                {% endfor %}

                {% if this.results is empty %}
                    <p class="px-3.5 py-2.5 text-[13px] text-fg-3">{{ 'label.no_result'|trans }}</p>
                {% endif %}

                {% if this.creatable %}
                    <button type="button" role="option" aria-selected="false"
                            class="flex cursor-pointer items-center gap-2.5 border-t border-line px-3.5 py-2.5 text-left text-[13.5px] font-semibold text-accent-text hover:bg-tile-2"
                            data-action="live#action" data-live-action-param="startCreating">
                        {{ include('App/_partials/_icon.html.twig', {name: 'plus', small: true}) }}
                        {{ 'label.create_named_location'|trans({'%name%': this.creatable}) }}
                    </button>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
</div>
