<!doctype html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Goshuin{% endblock %}</title>

    {# Runs before the first paint so a stored choice never flashes the other theme. #}
    <script>
        (function () {
            var chosen = null;
            try { chosen = window.localStorage.getItem('goshuin.theme'); } catch (e) {}
            if (chosen === 'dark' || chosen === 'light') {
                document.documentElement.setAttribute('data-theme', chosen);
            }
        })();
    </script>

    {{ encore_entry_link_tags('app') }}
</head>
<body>
    {{ include('App/_partials/_icons.html.twig') }}

    {% block bar %}{% endblock %}

    {% block body %}{% endblock %}

    {{ encore_entry_script_tags('app') }}
</body>
</html>
