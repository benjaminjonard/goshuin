<!doctype html>
<html lang="{{ app.request.locale|default('en') }}"{% if app.user and app.user.theme.attribute %} data-theme="{{ app.user.theme.attribute }}"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Goshuin{% endblock %}</title>

    {{ encore_entry_link_tags('app') }}
</head>
<body>
    {{ include('App/_partials/_icons.html.twig') }}

    {% block bar %}{% endblock %}

    {{ include('App/_partials/_flashes.html.twig') }}

    {% block body %}{% endblock %}

    {{ encore_entry_script_tags('app') }}
</body>
</html>
