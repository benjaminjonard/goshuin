<!doctype html>
<html lang="{{ app.request.locale|default('en') }}"{% if app.user and app.user.theme.attribute %} data-theme="{{ app.user.theme.attribute }}"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Goshuin{% endblock %}</title>

    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="32x32">
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
    <link rel="manifest" href="{{ asset('site.webmanifest') }}">
    <meta name="theme-color" content="#c0574a">

    {{ reprise_entry_link_tags('app') }}
</head>
<body>
    {{ include('App/_partials/_icons.html.twig') }}

    {% block bar %}{% endblock %}

    {% block body %}{% endblock %}

    {{ reprise_entry_script_tags('app') }}
</body>
</html>
