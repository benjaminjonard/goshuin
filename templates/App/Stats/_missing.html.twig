{% set stated = lines|filter(line => line.on and line.count) %}

{% if stated is not empty %}
    <p class="mt-3.5 grid gap-1 text-[12.5px] tabular-nums text-fg-3">
        {% for line in stated %}
            <span data-missing>{{ line.label|trans({'count': line.count}) }}</span>
        {% endfor %}
    </p>
{% endif %}
