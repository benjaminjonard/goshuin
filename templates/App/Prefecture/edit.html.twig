{% extends 'base.html.twig' %}

{% block title %}{{ prefecture.displayName(app.request.locale) }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {
        kicker: [{label: 'label.prefectures'|trans, href: path('app_prefecture_index')}],
        title: prefecture.displayName(app.request.locale),
    }) }}
{% endblock %}

{% block body %}
    <main class="page mx-auto grid w-full max-w-[560px] gap-[clamp(12px,1.4vw,18px)]">
        {{ form_start(form, {attr: {class: 'grid gap-[clamp(12px,1.4vw,18px)]', enctype: 'multipart/form-data'}}) }}
            {{ include('App/Prefecture/_form.html.twig') }}

            <div class="mt-1 flex justify-end gap-2.5">
                {{ include('App/_partials/_button.html.twig', {label: 'label.cancel'|trans, href: path('app_prefecture_show', {id: prefecture.id})}) }}
                {{ include('App/_partials/_button.html.twig', {label: 'label.save'|trans, variant: 'primary', type: 'submit', name: 'prefecture_submit'}) }}
            </div>
        {{ form_end(form) }}
    </main>
{% endblock %}
