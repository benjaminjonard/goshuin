{% extends 'base.html.twig' %}

{% block title %}{{ 'label.delete'|trans }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {
        kicker: [{label: 'label.prefectures'|trans, href: path('app_prefecture_index')}],
        title: prefecture.name,
    }) }}
{% endblock %}

{% block body %}
    <main class="page mx-auto grid w-full max-w-[560px] gap-[clamp(12px,1.4vw,18px)]">
        <div class="tile tile-pad grid gap-4">
            {% if held %}
                <h2 class="text-[15px] font-bold tracking-[-0.015em]">{{ 'error.prefecture_referenced'|trans }}</h2>

                <div class="flex justify-end gap-2.5">
                    {{ include('App/_partials/_button.html.twig', {label: 'label.back'|trans, href: path('app_prefecture_show', {id: prefecture.id})}) }}
                </div>
            {% else %}
                <h2 class="text-[15px] font-bold tracking-[-0.015em]">{{ 'label.delete_prefecture'|trans({'%name%': prefecture.name}) }}</h2>

                {{ form_start(form, {attr: {class: 'flex justify-end gap-2.5'}}) }}
                    {{ include('App/_partials/_button.html.twig', {label: 'label.cancel'|trans, href: path('app_prefecture_show', {id: prefecture.id})}) }}
                    {{ include('App/_partials/_button.html.twig', {label: 'label.delete'|trans, icon: 'trash', variant: 'primary', type: 'submit', name: 'delete_submit'}) }}
                {{ form_end(form) }}
            {% endif %}
        </div>
    </main>
{% endblock %}
