{% extends 'base.html.twig' %}

{% block title %}{{ prefecture.displayName(app.request.locale) }} · Goshuin{% endblock %}

{% block bar %}
    {% embed 'App/_partials/_bar.html.twig' with {
        title: prefecture.displayName(app.request.locale),
        kicker: [{label: 'label.prefectures'|trans, href: path('app_prefecture_index')}],
    } %}
        {% block tools %}
            {{ include('App/_partials/_button.html.twig', {icon: 'edit', href: path('app_prefecture_edit', {id: prefecture.id}), aria: 'label.edit'|trans}) }}
            {{ include('App/_partials/_button.html.twig', {icon: 'trash', href: path('app_prefecture_delete', {id: prefecture.id}), aria: 'label.delete'|trans}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    <main class="page stack" data-controller="lightbox">
        <div class="grid gap-[clamp(12px,1.4vw,18px)]{{ prefecture.photographFull ? ' min-[1060px]:grid-cols-2' }}">
            {% if prefecture.photographFull %}
                <section class="tile stage">
                    <a href="{{ prefecture.photograph|image }}" class="block" data-action="lightbox#open">
                        <img src="{{ prefecture.photographFull|image }}" alt="{{ prefecture.displayName(app.request.locale) }}"
                             class="photograph">
                    </a>
                </section>
            {% endif %}

            <div class="{{ prefecture.photographFull ? 'min-[1060px]:relative' }}">
                <div class="flex flex-col gap-[clamp(12px,1.4vw,18px)]{{ prefecture.photographFull ? ' min-[1060px]:absolute min-[1060px]:inset-0' }}">
                    {{ include('App/_partials/_totals.html.twig', {totals: [
                        {icon: 'city', value: cities, label: 'label.stat_cities', href: path('app_city_index', {prefecture: prefecture.id})},
                        {icon: 'pin', value: locations, label: 'label.stat_locations', href: path('app_location_index', {prefecture: prefecture.id})},
                    ]}) }}

                    {% if prefecture.notes is not empty %}
                        {% embed 'App/_partials/_section.html.twig' with {title: 'label.notes'|trans, class: 'flex min-h-0 flex-col'} %}
                            {% block content %}
                                <div class="min-h-0 overflow-y-auto text-[14.5px] leading-[1.75] text-fg-2">{{ prefecture.notes|deities }}</div>
                            {% endblock %}
                        {% endembed %}
                    {% endif %}
                </div>
            </div>
        </div>

        {{ include('App/_partials/_visits.html.twig') }}

        {{ include('App/_partials/_gallery.html.twig', {photos: prefecture.photos, title: 'label.photographs'|trans}) }}

        {% if prefecture.photographFull or prefecture.photos is not empty %}
            {{ include('App/_partials/_lightbox.html.twig') }}
        {% endif %}
    </main>
{% endblock %}
