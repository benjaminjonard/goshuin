<main class="page mx-auto grid w-full max-w-[720px] gap-[clamp(12px,1.4vw,18px)]">
    {{ form_start(form, {attr: {class: 'tile tile-pad grid gap-4'}}) }}
        {{ form_errors(form) }}
        <div class="grid gap-4 min-[700px]:grid-cols-[176px_minmax(0,1fr)]">
            <div class="grid gap-1.5">
                {{ form_widget(form.imageFile, {attr: {'data-image': form.vars.data.imageCard}}) }}
                {{ form_errors(form.imageFile) }}
            </div>
            <div class="grid content-start gap-4">
                {{ form_row(form.goshuincho) }}
                {{ form_row(form.location) }}
                {{ form_row(form.receivedOn) }}
            </div>
        </div>

        <div class="mt-1 flex justify-end gap-2.5">
            {{ include('App/_partials/_button.html.twig', {label: 'label.cancel'|trans, href: cancel}) }}
            {{ include('App/_partials/_button.html.twig', {label: 'label.save'|trans, variant: 'primary', type: 'submit', name: 'goshuin_submit'}) }}
        </div>
    {{ form_end(form) }}
</main>
