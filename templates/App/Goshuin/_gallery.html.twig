{% if photos is not empty %}
    {% embed 'App/_partials/_section.html.twig' with {title: ('label.photos_' ~ type)|trans, aux: photos|length} %}
        {% block content %}
            <ol class="grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-2.5">
                {% for photo in photos %}
                    <li>
                        <figure class="shot">
                            <img src="{{ photo.imageCard|image }}" class="shot-image"
                                 alt="{{ photo.label ?: 'label.photographs'|trans }}">
                            {% if photo.label %}
                                <figcaption class="shot-caption">{{ photo.label }}</figcaption>
                            {% endif %}
                        </figure>
                    </li>
                {% endfor %}
            </ol>
        {% endblock %}
    {% endembed %}
{% endif %}
