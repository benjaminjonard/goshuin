{% extends 'base.html.twig' %}

{% block title %}{{ goshuin.location.romanizedName }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {
        kicker: [
            {label: 'label.goshuincho'|trans, href: path('app_homepage')},
            {label: goshuincho.title, href: path('app_goshuincho_show', {slug: goshuincho.slug})},
        ],
        title: goshuin.location.romanizedName,
        jp: goshuin.location.japaneseName,
    }) }}
{% endblock %}

{% block body %}
    {{ include('App/Goshuin/_form.html.twig', {cancel: path('app_goshuin_show', {slug: goshuincho.slug, position: goshuin.position})}) }}
{% endblock %}
