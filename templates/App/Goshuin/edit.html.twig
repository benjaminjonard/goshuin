{% extends 'base.html.twig' %}

{% block title %}{{ goshuin.location.displayName(app.request.locale) }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {
        kicker: [
            {label: 'label.goshuincho'|trans, href: path('app_homepage')},
            {label: goshuincho.title, href: path('app_goshuincho_show', {id: goshuincho.id})},
        ],
        title: goshuin.location.displayName(app.request.locale),
        jp: goshuin.location.secondaryName(app.request.locale),
    }) }}
{% endblock %}

{% block body %}
    {{ include('App/Goshuin/_form.html.twig', {cancel: path('app_goshuin_show', {id: goshuincho.id, position: goshuin.position})}) }}
{% endblock %}
