{% extends 'base.html.twig' %}

{% block title %}{{ 'label.sign_in'|trans }} · Goshuin{% endblock %}

{% block body %}
    <main class="mx-auto grid w-full max-w-[420px] gap-[clamp(12px,1.4vw,18px)] px-[clamp(14px,2.6vw,30px)] pt-[clamp(28px,9vw,96px)] pb-[clamp(34px,4vw,54px)]">
        <div class="text-center">
            <span class="mx-auto mb-4 grid size-[52px] place-items-center rounded-2xl bg-accent-soft" aria-hidden="true">
                <svg class="size-8 fill-accent" viewBox="0 0 32 32"><use href="#i-torii"/></svg>
            </span>
            <h1 class="text-[clamp(20px,2.4vw,24px)] font-bold tracking-[-0.02em]">Goshuin</h1>
        </div>

        <form method="post" class="tile tile-pad grid gap-4">
            {% if error %}
                <p class="flex items-start gap-2.5 rounded-xl border border-accent-line bg-accent-soft px-3.5 py-3 text-[12.5px] leading-relaxed text-accent-text" role="alert">
                    {{ include('App/_partials/_icon.html.twig', {name: 'info', small: true, class: 'mt-px'}) }}
                    <span>{{ (throttled ? 'error.too_many_attempts' : 'error.credentials')|trans }}</span>
                </p>
            {% endif %}

            <div class="grid gap-1.5">
                <label for="email" class="text-[12.5px] font-semibold text-fg-2">{{ 'label.email'|trans }}</label>
                <input type="email" id="email" name="_username" value="{{ lastEmail }}" autocomplete="email" required autofocus
                       class="w-full rounded-xl border border-line-2 bg-tile-2 px-3.5 py-2.5 text-[15px] text-fg hover:border-fg-3 focus-visible:border-accent focus-visible:bg-tile">
            </div>

            <div class="grid gap-1.5">
                <label for="password" class="text-[12.5px] font-semibold text-fg-2">{{ 'label.password'|trans }}</label>
                <input type="password" id="password" name="_password" autocomplete="current-password" required
                       class="w-full rounded-xl border border-line-2 bg-tile-2 px-3.5 py-2.5 text-[15px] text-fg hover:border-fg-3 focus-visible:border-accent focus-visible:bg-tile">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="mt-1">
                <button type="submit" name="login_submit" class="w-full cursor-pointer rounded-xl border border-accent bg-accent px-4 py-2.5 text-sm font-semibold text-white transition-[filter] hover:brightness-105 dark:text-[#24100d]">
                    {{ 'label.sign_in'|trans }}
                </button>
            </div>
        </form>
    </main>
{% endblock %}
