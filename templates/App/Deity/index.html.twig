{% extends 'base.html.twig' %}

{% block title %}{{ 'label.deities'|trans }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {title: 'label.deities'|trans}) }}
{% endblock %}

{% block body %}
    {{ include('App/_partials/_list.html.twig', {
        route: 'app_deity_index',
        search: 'label.deity_search',
        nothing: 'label.no_deity_yet',
        noun: 'label.deities',
        cards: deities|map(deity => {
            href: path('app_deity_show', {slug: deity.slug}),
            image: deity.photographCard,
            icon: 'tag',
            title: deity.name,
            below: deity.additionalNames|join(' · '),
        }),
    }) }}
{% endblock %}
