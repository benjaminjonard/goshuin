{% extends 'base.html.twig' %}

{% block title %}{{ deity.displayName(app.request.locale) }} · Goshuin{% endblock %}

{% block bar %}
    {% embed 'App/_partials/_bar.html.twig' with {
        title: deity.displayName(app.request.locale),
        kicker: [{label: 'label.deities'|trans, href: path('app_deity_index')}],
    } %}
        {% block tools %}
            {{ include('App/_partials/_button.html.twig', {icon: 'edit', href: path('app_deity_edit', {id: deity.id}), aria: 'label.edit'|trans}) }}
            {{ include('App/_partials/_button.html.twig', {icon: 'trash', href: path('app_deity_delete', {id: deity.id}), aria: 'label.delete'|trans}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    {% set aside = deity.photographFull or deity.additionalNames is not empty or deity.description is not empty %}

    <main class="page stack" data-controller="lightbox">
        <div class="grid gap-[clamp(12px,1.4vw,18px)]{{ aside ? ' min-[1060px]:grid-cols-2' }}">
        {% if aside %}
            <div class="grid content-start gap-[clamp(12px,1.4vw,18px)]">
                {% if deity.photographFull %}
                    <section class="tile stage">
                        <a href="{{ deity.photograph|image }}" class="block" data-action="lightbox#open">
                            <img src="{{ deity.photographFull|image }}" alt="{{ deity.displayName(app.request.locale) }}"
                                 class="photograph">
                        </a>
                    </section>
                {% endif %}

                {% if deity.additionalNames is not empty %}
                    {% embed 'App/_partials/_section.html.twig' with {title: 'label.additional_names'|trans} %}
                        {% block content %}
                            {{ include('App/_partials/_pills.html.twig', {pills: deity.additionalNames|map(name => {text: name})}) }}
                        {% endblock %}
                    {% endembed %}
                {% endif %}

                {% if deity.description is not empty %}
                    {% embed 'App/_partials/_section.html.twig' with {title: 'label.description'|trans} %}
                        {% block content %}
                            <div class="text-[14.5px] leading-[1.75] text-fg-2">{{ deity.description|deities(deity) }}</div>
                        {% endblock %}
                    {% endembed %}
                {% endif %}
            </div>
        {% endif %}

        {% embed 'App/_partials/_section.html.twig' with {
            title: 'label.locations'|trans,
            aux: locations is not empty ? 'label.places'|trans({'count': locations|length}) : null,
        } %}
            {% block content %}
                {% if locations is empty %}
                    <p class="text-[14.5px] text-fg-2">{{ 'label.no_location_yet'|trans }}</p>
                {% else %}
                    <ul class="grid gap-0">
                        {% for location in locations %}
                            <li class="not-first:border-t not-first:border-line">
                                <a href="{{ path('app_location_show', {id: location.id}) }}"
                                   class="flex items-center gap-3 rounded-xl px-2 py-2.5 no-underline hover:bg-tile-2">
                                    <span class="grid size-8 shrink-0 place-items-center rounded-[10px] bg-accent-soft text-accent-text" aria-hidden="true">
                                        {{ include('App/_partials/_icon.html.twig', {name: 'pin', small: true}) }}
                                    </span>
                                    <span class="min-w-0 flex-auto">
                                        <span class="block truncate text-[13.5px] font-semibold text-fg">{{ location.displayName(app.request.locale) }}</span>
                                        {% set below = [location.secondaryName(app.request.locale), location.city ? location.city.displayName(app.request.locale) : null, location.prefecture ? location.prefecture.displayName(app.request.locale) : null]|filter(part => part is not empty)|join(' · ') %}
                                        {% if below is not empty %}
                                            <span class="block truncate text-xs text-fg-3">{{ below }}</span>
                                        {% endif %}
                                    </span>
                                    <span class="shrink-0 text-fg-3" aria-hidden="true">
                                        {{- include('App/_partials/_icon.html.twig', {name: 'right', small: true}) -}}
                                    </span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endblock %}
        {% endembed %}
        </div>

        {% if deity.photographFull %}
            {{ include('App/_partials/_lightbox.html.twig') }}
        {% endif %}
    </main>
{% endblock %}
