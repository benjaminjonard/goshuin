{% extends 'base.html.twig' %}

{% block title %}{{ 'label.delete'|trans }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {
        kicker: [{label: 'label.deities'|trans, href: path('app_deity_index')}],
        title: deity.name,
    }) }}
{% endblock %}

{% block body %}
    {{ include('App/_partials/_delete.html.twig', {
        subject: deity.name,
        back: path('app_deity_show', {slug: deity.slug}),
        referenced: 'error.deity_referenced',
        confirm: 'label.delete_deity',
    }) }}
{% endblock %}
