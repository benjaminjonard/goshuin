{% extends 'base.html.twig' %}

{% block title %}{{ 'label.delete'|trans }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {kicker: [{label: 'label.goshuincho'|trans, href: path('app_homepage')}], title: goshuincho.title}) }}
{% endblock %}

{% block body %}
    <main class="page mx-auto grid w-full max-w-[560px] gap-[clamp(12px,1.4vw,18px)]">
        <div class="tile tile-pad grid gap-4">
            <h2 class="text-[15px] font-bold tracking-[-0.015em]">{{ 'label.delete_goshuincho'|trans({'title': goshuincho.title}) }}</h2>

            {{ form_start(form, {attr: {class: 'flex justify-end gap-2.5'}}) }}
                {{ include('App/_partials/_button.html.twig', {label: 'label.cancel'|trans, href: path('app_goshuincho_show', {id: goshuincho.id})}) }}
                {{ include('App/_partials/_button.html.twig', {label: 'label.delete'|trans, icon: 'trash', variant: 'primary', type: 'submit', name: 'delete_submit'}) }}
            {{ form_end(form) }}
        </div>
    </main>
{% endblock %}
