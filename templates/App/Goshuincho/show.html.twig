{% extends 'base.html.twig' %}

{% block title %}{{ goshuincho.title }} · Goshuin{% endblock %}

{% block bar %}
    {% embed 'App/_partials/_bar.html.twig' with {kicker: 'label.goshuincho'|trans, title: goshuincho.title, back: path('app_homepage')} %}
        {% block tools %}
            {{ include('App/_partials/_button.html.twig', {icon: 'edit', href: path('app_goshuincho_edit', {slug: goshuincho.slug}), aria: 'label.edit'|trans}) }}
            {{ include('App/_partials/_button.html.twig', {icon: 'trash', href: path('app_goshuincho_delete', {slug: goshuincho.slug}), aria: 'label.delete'|trans}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    <main class="page mx-auto grid w-full max-w-[720px] gap-[clamp(12px,1.4vw,18px)]">
        {% if goshuincho.description is not empty or goshuincho.purchasedAt or goshuincho.price is not null %}
            {% embed 'App/_partials/_section.html.twig' with {title: 'label.goshuincho'|trans} %}
                {% block content %}
                    <div class="grid gap-4">
                        {% if goshuincho.description is not empty %}
                            <p class="text-sm leading-relaxed text-fg-2">{{ goshuincho.description|nl2br }}</p>
                        {% endif %}

                        {{ include('App/_partials/_kvs.html.twig', {rows: [
                            {label: 'label.purchased_on'|trans, value: goshuincho.purchasedAt ? goshuincho.purchasedAt|format_date('long') : null},
                            {label: 'label.price_paid'|trans, value: goshuincho.price|money(goshuincho.currency)},
                        ]}) }}
                    </div>
                {% endblock %}
            {% endembed %}
        {% endif %}

        <div class="tile tile-pad text-center">
            <span class="mx-auto mb-4 grid size-[52px] place-items-center rounded-2xl bg-accent-soft" aria-hidden="true">
                {{ include('App/_partials/_icon.html.twig', {name: 'seal', class: 'size-7 text-accent-text'}) }}
            </span>
            <h2 class="text-[15px] font-bold tracking-[-0.015em]">{{ 'label.no_goshuin_yet'|trans }}</h2>
        </div>
    </main>
{% endblock %}
