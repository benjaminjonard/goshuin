{% extends 'base.html.twig' %}

{% block title %}{{ goshuincho.title }} · Goshuin{% endblock %}

{% block bar %}
    {% embed 'App/_partials/_bar.html.twig' with {kicker: 'label.goshuincho'|trans, title: goshuincho.title, back: path('app_homepage')} %}
        {% block tools %}
            {{ include('App/_partials/_button.html.twig', {icon: 'edit', href: path('app_goshuincho_edit', {slug: goshuincho.slug}), aria: 'label.edit'|trans}) }}
            {{ include('App/_partials/_button.html.twig', {icon: 'trash', href: path('app_goshuincho_delete', {slug: goshuincho.slug}), aria: 'label.delete'|trans}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    <main class="page cols" data-controller="linked">
        <div class="stack">
            {% embed 'App/_partials/_section.html.twig' with {title: 'label.goshuincho'|trans} %}
                {% block content %}
                    <div class="grid gap-4">
                        {% if goshuincho.coverFrontFull or goshuincho.coverBackFull %}
                            <div class="grid gap-3.5 sm:grid-cols-2">
                                {% for cover in [
                                    {path: goshuincho.coverFrontFull, caption: 'label.cover_front'},
                                    {path: goshuincho.coverBackFull, caption: 'label.cover_back'},
                                ]|filter(cover => cover.path) %}
                                    <figure class="grid gap-1.5">
                                        <img src="{{ cover.path|image }}" alt="{{ cover.caption|trans }}"
                                             class="w-full rounded-2xl border border-line bg-tile-2 object-contain">
                                        <figcaption class="text-xs text-fg-3">{{ cover.caption|trans }}</figcaption>
                                    </figure>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="grid place-items-center gap-2 rounded-2xl border border-line bg-tile-2 px-4 py-8 text-center">
                                {{ include('App/_partials/_icon.html.twig', {name: 'goshuincho', class: 'text-fg-3'}) }}
                                <span class="text-[13px] text-fg-3">{{ 'label.no_cover'|trans }}</span>
                            </div>
                        {% endif %}

                        {% if goshuincho.description is not empty %}
                            <p class="text-sm leading-relaxed text-fg-2">{{ goshuincho.description|nl2br }}</p>
                        {% endif %}

                        {{ include('App/_partials/_kvs.html.twig', {rows: [
                            {label: 'label.bought_at'|trans, value: goshuincho.boughtAt ? goshuincho.boughtAt.romanizedName : null},
                            {label: 'label.purchased_on'|trans, value: goshuincho.purchasedAt ? goshuincho.purchasedAt|format_date('long') : null},
                            {label: 'label.price_paid'|trans, value: goshuincho.price|money(goshuincho.currency)},
                        ]}) }}

                        {{ include('App/_partials/_pills.html.twig', {pills: [
                            {text: summary.first ? summary.first|format_datetime(pattern='LLLL y') : null, icon: 'cal', hot: true},
                            {text: summary.region ? summary.region.japanese ~ ' ' ~ summary.region.romanized : null, jp: true},
                        ]}) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed 'App/_partials/_section.html.twig' with {title: 'label.goshuin'|trans, aux: 'label.in_order'|trans} %}
                {% block content %}
                    {% if legs is not empty %}
                        <ol class="grid grid-cols-[repeat(auto-fill,minmax(112px,1fr))] gap-3.5">
                            {% for leg in legs %}
                                <li data-index="{{ leg.goshuin.position }}">
                                    <a href="{{ path('app_goshuin_show', {slug: goshuincho.slug, position: leg.goshuin.position}) }}" class="grid gap-1.5 no-underline">
                                        <img src="{{ leg.goshuin.imageCard|image }}" alt="{{ leg.goshuin.location.romanizedName }}" class="image-frame">
                                        <span class="text-[13px] font-semibold text-fg">{{ leg.goshuin.location.romanizedName }}</span>
                                        {% if leg.goshuin.receivedOn %}
                                            <span class="text-xs tabular-nums text-fg-3">{{ leg.goshuin.receivedOn|format_date('long') }}</span>
                                        {% endif %}
                                    </a>
                                </li>
                            {% endfor %}
                        </ol>
                    {% else %}
                        <div class="grid place-items-center gap-2 py-4 text-center">
                            <span class="grid size-[52px] place-items-center rounded-2xl bg-accent-soft" aria-hidden="true">
                                {{ include('App/_partials/_icon.html.twig', {name: 'goshuin', class: 'size-7 text-accent-text'}) }}
                            </span>
                            <span class="text-[13px] text-fg-3">{{ 'label.no_goshuin_yet'|trans }}</span>
                        </div>
                    {% endif %}

                    <div class="mt-4 flex justify-center">
                        {{ include('App/_partials/_button.html.twig', {
                            label: 'label.add_goshuin'|trans,
                            variant: 'primary',
                            icon: 'plus',
                            href: path('app_goshuin_add', {slug: goshuincho.slug}),
                        }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% set tiles = [
                {icon: 'goshuin', value: summary.goshuin ?: null, label: 'label.stat_goshuin'},
                {icon: 'pin', value: summary.locations ?: null, label: 'label.stat_places'},
                {icon: 'cal', value: summary.days, label: 'label.stat_days'},
            ]|filter(tile => tile.value) %}

            {% if tiles is not empty or summary.spend is not empty %}
                <div class="grid grid-cols-2 gap-[clamp(10px,1.2vw,14px)] sm:grid-cols-4">
                    {% for tile in tiles %}
                        <div class="tile flex items-center gap-2.5 p-3.5">
                            <span class="grid size-8 shrink-0 place-items-center rounded-[10px] bg-accent-soft text-accent-text" aria-hidden="true">
                                {{ include('App/_partials/_icon.html.twig', {name: tile.icon, small: true}) }}
                            </span>
                            <span>
                                <span class="block text-[19px] font-bold tabular-nums leading-none">{{ tile.value }}</span>
                                <span class="block text-[11.5px] text-fg-3">{{ tile.label|trans({'%count%': tile.value}) }}</span>
                            </span>
                        </div>
                    {% endfor %}
                    {% for currency, total in summary.spend %}
                        <div class="tile flex items-center gap-2.5 p-3.5">
                            <span class="grid size-8 shrink-0 place-items-center rounded-[10px] bg-accent-soft text-accent-text" aria-hidden="true">
                                {{ include('App/_partials/_icon.html.twig', {name: 'yen', small: true}) }}
                            </span>
                            <span>
                                <span class="block text-[19px] font-bold tabular-nums leading-none">{{ total|money(currency) }}</span>
                                <span class="block text-[11.5px] text-fg-3">{{ 'label.stat_spent'|trans }}</span>
                            </span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="stack">
            {% if pinned is not empty %}
                {% embed 'App/_partials/_section.html.twig' with {
                    title: 'label.where_they_come_from'|trans,
                    aux: [
                        'label.pins'|trans({'%count%': pinned|length}),
                        'label.places'|trans({'%count%': summary.locations}),
                        summary.spread ? 'label.spread'|trans({'%count%': summary.spread}) : null,
                    ]|filter(part => part)|join(' · '),
                } %}
                    {% block content %}
                        <div data-controller="map"
                             data-map-mode-value="numbered"
                             data-map-tiles-value="{{ map_tiles }}"
                             data-map-attribution-value="{{ map_attribution }}"
                             data-map-markers-value="{{ pinned|map(leg => {
                                 latitude: leg.goshuin.location.latitude,
                                 longitude: leg.goshuin.location.longitude,
                                 number: leg.goshuin.position,
                                 index: leg.goshuin.position,
                                 label: leg.goshuin.location.romanizedName,
                                 href: path('app_goshuin_show', {slug: goshuincho.slug, position: leg.goshuin.position}),
                             })|json_encode }}">
                            <div class="minimap h-[clamp(260px,42vh,420px)]" data-map-target="canvas"></div>
                            <ul class="sr">
                                {% for leg in pinned %}
                                    <li>{{ leg.goshuin.position }}. {{ leg.goshuin.location.romanizedName }}{{ leg.goshuin.receivedOn ? ' · ' ~ leg.goshuin.receivedOn|format_date('long') }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {% if legs is not empty %}
                {% embed 'App/_partials/_section.html.twig' with {
                    title: 'label.the_trip'|trans,
                    aux: summary.days ? 'label.days'|trans({'%count%': summary.days}) : null,
                } %}
                    {% block content %}
                        <ol class="grid gap-0">
                            {% for leg in legs %}
                                {% if leg.days %}
                                    <li class="flex items-center gap-[7px] py-1 pl-[38px] text-[11.5px] text-fg-3">
                                        <span class="h-px w-3.5 bg-line-2" aria-hidden="true"></span>
                                        {{ 'label.days_later'|trans({'%count%': leg.days}) }}
                                    </li>
                                {% elseif leg.sameDay %}
                                    <li class="flex items-center gap-[7px] py-1 pl-[38px] text-[11.5px] text-fg-3">
                                        <span class="h-px w-3.5 bg-line-2" aria-hidden="true"></span>
                                        {{ 'label.same_day'|trans }}
                                    </li>
                                {% endif %}
                                <li class="flex items-baseline gap-3 rounded-xl px-2 py-2 not-first:border-t not-first:border-line"
                                    data-index="{{ leg.goshuin.position }}">
                                    <span class="grid size-[26px] shrink-0 place-items-center rounded-full bg-tile-2 text-[12px] font-bold tabular-nums text-fg-2">{{ leg.goshuin.position }}</span>
                                    <span class="min-w-0 flex-auto">
                                        <a href="{{ path('app_goshuin_show', {slug: goshuincho.slug, position: leg.goshuin.position}) }}"
                                           class="block truncate text-[14.5px] font-semibold text-fg no-underline hover:text-accent-text">
                                            {{- leg.goshuin.location.japaneseName ?: leg.goshuin.location.romanizedName -}}
                                        </a>
                                        {% set below = [
                                            leg.goshuin.location.japaneseName ? leg.goshuin.location.romanizedName : null,
                                            leg.goshuin.location.locality,
                                            leg.goshuin.price|money(leg.goshuin.currency) ?: null,
                                        ]|filter(part => part)|join(' · ') %}
                                        {% if below is not empty %}
                                            <span class="block truncate text-xs text-fg-3">{{ below }}</span>
                                        {% endif %}
                                    </span>
                                    {% if leg.goshuin.receivedOn %}
                                        <span class="shrink-0 text-[12.5px] tabular-nums text-fg-2">{{ leg.goshuin.receivedOn|format_date('long') }}</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </div>
    </main>
{% endblock %}
