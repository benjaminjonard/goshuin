{% extends 'base.html.twig' %}

{% block title %}{{ goshuincho.title }} · Goshuin{% endblock %}

{% block bar %}
    {% embed 'App/_partials/_bar.html.twig' with {kicker: [{label: 'label.goshuincho'|trans, href: path('app_homepage')}], title: goshuincho.title} %}
        {% block tools %}
            {{ include('App/_partials/_button.html.twig', {icon: 'edit', href: path('app_goshuincho_edit', {slug: goshuincho.slug}), aria: 'label.edit'|trans}) }}
            {{ include('App/_partials/_button.html.twig', {icon: 'trash', href: path('app_goshuincho_delete', {slug: goshuincho.slug}), aria: 'label.delete'|trans}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    <main class="page cols" data-controller="linked">
        <div class="stack">
            {% embed 'App/_partials/_section.html.twig' with {title: 'label.goshuincho'|trans} %}
                {% block content %}
                    <div class="grid gap-4">
                        {% if goshuincho.coverFrontFull or goshuincho.coverBackFull %}
                            <div class="grid gap-3.5 sm:grid-cols-2">
                                {% for cover in [
                                    {path: goshuincho.coverFrontFull, caption: 'label.cover_front'},
                                    {path: goshuincho.coverBackFull, caption: 'label.cover_back'},
                                ]|filter(cover => cover.path) %}
                                    <figure class="grid gap-1.5">
                                        <img src="{{ cover.path|image }}" alt="{{ cover.caption|trans }}"
                                             class="w-full rounded-2xl border border-line bg-tile-2 object-contain">
                                        <figcaption class="text-xs text-fg-3">{{ cover.caption|trans }}</figcaption>
                                    </figure>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="grid place-items-center gap-2 rounded-2xl border border-line bg-tile-2 px-4 py-8 text-center">
                                {{ include('App/_partials/_icon.html.twig', {name: 'goshuincho', class: 'text-fg-3'}) }}
                                <span class="text-[13px] text-fg-3">{{ 'label.no_cover'|trans }}</span>
                            </div>
                        {% endif %}

                        {% set origin = goshuincho.boughtAt %}

                        {{ include('App/_partials/_kvs.html.twig', {rows: [
                            {
                                label: 'label.origin'|trans,
                                value: origin ? [origin.japaneseName, origin.romanizedName]|filter(part => part)|join(' · ') : null,
                                jp: origin and origin.japaneseName is not empty,
                            },
                            {label: 'label.purchased_on'|trans, value: goshuincho.purchasedAt ? goshuincho.purchasedAt|format_date('long') : null},
                            {label: 'label.price_paid'|trans, value: goshuincho.price|money(goshuincho.currency)},
                        ]}) }}

                        {% for places in [
                            {label: 'label.cities', held: summary.cities},
                            {label: 'label.prefectures', held: summary.prefectures},
                        ]|filter(places => places.held is not empty) %}
                            <div class="grid gap-1.5">
                                <span class="text-[12.5px] font-semibold text-fg-2">{{ places.label|trans }}</span>
                                {{ include('App/_partials/_pills.html.twig', {pills: places.held|map(place => {text: place})}) }}
                            </div>
                        {% endfor %}

                        {% if goshuincho.description is not empty %}
                            <p class="text-sm leading-relaxed text-fg-2">{{ goshuincho.description|nl2br }}</p>
                        {% endif %}
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed 'App/_partials/_section.html.twig' with {title: 'label.goshuin'|trans, aux: 'label.in_order'|trans} %}
                {% block content %}
                    {% if goshuincho.goshuins|length %}
                        <ol class="gallery">
                            {% for goshuin in goshuincho.goshuins %}
                                <li class="card" data-index="{{ goshuin.position }}">
                                    <a href="{{ path('app_goshuin_show', {slug: goshuincho.slug, position: goshuin.position}) }}" class="grid gap-1.5 no-underline">
                                        <img src="{{ goshuin.imageCard|image }}" alt="{{ goshuin.location.romanizedName }}" class="image-frame"
                                             {% if goshuin.imageWidth and goshuin.imageHeight %}width="{{ goshuin.imageWidth }}" height="{{ goshuin.imageHeight }}"{% endif %}>
                                        <span class="block w-0 min-w-full text-[13px] font-semibold text-fg">{{ goshuin.location.romanizedName }}</span>
                                        {% if goshuin.receivedOn %}
                                            <span class="block w-0 min-w-full text-xs tabular-nums text-fg-3">{{ goshuin.receivedOn|format_date('long') }}</span>
                                        {% endif %}
                                    </a>
                                </li>
                            {% endfor %}
                        </ol>
                    {% else %}
                        <div class="grid place-items-center gap-2 py-4 text-center">
                            <span class="grid size-[52px] place-items-center rounded-2xl bg-accent-soft" aria-hidden="true">
                                {{ include('App/_partials/_icon.html.twig', {name: 'goshuin', class: 'size-7 text-accent-text'}) }}
                            </span>
                            <span class="text-[13px] text-fg-3">{{ 'label.no_goshuin_yet'|trans }}</span>
                        </div>
                    {% endif %}

                    <div class="mt-4 flex justify-center">
                        {{ include('App/_partials/_button.html.twig', {
                            label: 'label.add_goshuin'|trans,
                            variant: 'primary',
                            icon: 'plus',
                            href: path('app_goshuin_add', {slug: goshuincho.slug}),
                        }) }}
                    </div>
                {% endblock %}
            {% endembed %}

            {% set tiles = [
                {icon: 'goshuin', value: summary.goshuin ?: null, label: 'label.stat_goshuin'},
                {icon: 'pin', value: summary.cities|length ?: null, label: 'label.stat_cities'},
                {icon: 'map', value: summary.prefectures|length ?: null, label: 'label.stat_prefectures'},
                {icon: 'cal', value: summary.days, label: 'label.stat_days'},
            ]|filter(tile => tile.value) %}

            {% if tiles is not empty %}
                <div class="grid grid-cols-2 gap-[clamp(10px,1.2vw,14px)] min-[560px]:grid-cols-4">
                    {% for tile in tiles %}
                        <div class="tile flex items-center gap-2.5 p-3.5">
                            <span class="grid size-8 shrink-0 place-items-center rounded-[10px] bg-accent-soft text-accent-text" aria-hidden="true">
                                {{ include('App/_partials/_icon.html.twig', {name: tile.icon, small: true}) }}
                            </span>
                            <span>
                                <span class="block text-[19px] font-bold tabular-nums leading-none">{{ tile.value }}</span>
                                <span class="block text-[11.5px] text-fg-3">{{ tile.label|trans({'%count%': tile.value}) }}</span>
                            </span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="stack">
            {% if pinned is not empty %}
                {% embed 'App/_partials/_section.html.twig' with {
                    title: 'label.where_they_come_from'|trans,
                    aux: 'label.places'|trans({'%count%': summary.locations}),
                } %}
                    {% block content %}
                        <div data-controller="map"
                             data-map-mode-value="numbered"
                             data-map-tiles-value="{{ map_tiles }}"
                             data-map-attribution-value="{{ map_attribution }}"
                             data-map-markers-value="{{ pinned|map(goshuin => {
                                 latitude: goshuin.location.latitude,
                                 longitude: goshuin.location.longitude,
                                 number: goshuin.position,
                                 index: goshuin.position,
                                 label: goshuin.location.romanizedName,
                                 href: path('app_goshuin_show', {slug: goshuincho.slug, position: goshuin.position}),
                             })|json_encode }}">
                            <div class="minimap h-[clamp(260px,42vh,420px)]" data-map-target="canvas"></div>
                            <ul class="sr">
                                {% for goshuin in pinned %}
                                    <li>{{ goshuin.position }}. {{ goshuin.location.romanizedName }}{{ goshuin.receivedOn ? ' · ' ~ goshuin.receivedOn|format_date('long') }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {% if days is not empty %}
                {% embed 'App/_partials/_section.html.twig' with {
                    title: 'label.the_trip'|trans,
                    aux: summary.days ? 'label.days'|trans({'%count%': summary.days}) : null,
                } %}
                    {% block content %}
                        <ol class="grid gap-0">
                            {% for day in days %}
                                <li class="not-first:mt-1 not-first:border-t not-first:border-line not-first:pt-2">
                                    {% if day.date or day.after %}
                                        <p class="flex flex-wrap items-baseline gap-2.5 px-2 pb-1">
                                            {% if day.date %}
                                                <span class="text-[12.5px] font-semibold tabular-nums text-fg-2">{{ day.date|format_date('long') }}</span>
                                            {% endif %}
                                            {% if day.after %}
                                                <span class="flex items-center gap-[7px] text-[11.5px] text-fg-3">
                                                    <span class="h-px w-3.5 bg-line-2" aria-hidden="true"></span>
                                                    {{ 'label.days_later'|trans({'%count%': day.after}) }}
                                                </span>
                                            {% endif %}
                                        </p>
                                    {% endif %}
                                    <ol class="grid gap-0">
                                        {% for goshuin in day.goshuins %}
                                            <li>
                                                <a href="{{ path('app_goshuin_show', {slug: goshuincho.slug, position: goshuin.position}) }}"
                                                   class="flex items-baseline gap-3 rounded-xl px-2 py-1.5 no-underline"
                                                   data-index="{{ goshuin.position }}">
                                                    <span class="grid size-[26px] shrink-0 place-items-center rounded-full bg-tile-2 text-[12px] font-bold tabular-nums text-fg-2">{{ goshuin.position }}</span>
                                                    <span class="min-w-0 flex-auto">
                                                        <span class="block truncate text-[14.5px] font-semibold text-fg">
                                                            {{- goshuin.location.japaneseName ?: goshuin.location.romanizedName -}}
                                                        </span>
                                                        {% set below = [
                                                            goshuin.location.japaneseName ? goshuin.location.romanizedName : null,
                                                            goshuin.location.locality,
                                                        ]|filter(part => part)|join(' · ') %}
                                                        {% if below is not empty %}
                                                            <span class="block truncate text-xs text-fg-3">{{ below }}</span>
                                                        {% endif %}
                                                    </span>
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ol>
                                </li>
                            {% endfor %}
                        </ol>
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </div>
    </main>
{% endblock %}
