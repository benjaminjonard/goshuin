{% extends 'base.html.twig' %}

{% block title %}{{ 'label.goshuincho'|trans }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {title: 'label.goshuincho'|trans}) }}
{% endblock %}

{% block body %}
    {{ include('App/_partials/_list.html.twig', {
        route: 'app_goshuincho_index',
        search: 'label.goshuincho_search',
        nothing: 'label.home_empty',
        noun: 'label.goshuincho',
        cards: goshuinchos|map(goshuincho => {
            href: path('app_goshuincho_show', {id: goshuincho.id}),
            image: goshuincho.coverFrontCard,
            icon: 'goshuincho',
            title: goshuincho.title,
            hue: goshuincho.hue,
        }),
    }) }}
{% endblock %}
