{% extends 'base.html.twig' %}

{% block title %}Design tokens · Goshuin{% endblock %}

{% set colours = [
    'accent', 'accent-soft', 'accent-line', 'accent-text',
    'bg', 'tile', 'tile-2', 'fg', 'fg-2', 'fg-3', 'line', 'line-2',
    'land', 'land-2', 'forest', 'forest-2', 'urban', 'water', 'water-line', 'road',
    'ok', 'plum',
] %}

{% block bar %}
    {% embed 'App/_partials/_bar.html.twig' with {kicker: 'Stories 1.3 and 1.4', title: 'The shell', back: '/_design'} %}
        {% block tools %}
            {{ include('App/_partials/_button.html.twig', {label: 'Share', icon: 'share'}) }}
            {{ include('App/_partials/_button.html.twig', {label: 'Add a goshuin', icon: 'plus', variant: 'primary'}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    <main class="page">

        <section class="mb-12">
            <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-fg-2">Colours</h2>
            <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                {% for name in colours %}
                    <li class="rounded-xl border border-line bg-tile p-3">
                        <span class="mb-2 block h-12 rounded-lg border border-line-2" style="background: var(--color-{{ name }})"></span>
                        <code class="text-xs text-fg-2">{{ name }}</code>
                    </li>
                {% endfor %}
            </ul>
        </section>

        <section class="mb-12">
            <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-fg-2">Hue, from an angle alone</h2>
            <ul class="flex flex-wrap gap-3">
                {% for angle in [12, 150, 288, 66, 204, 330] %}
                    <li class="rounded-xl border border-line bg-tile p-3 text-center">
                        <span class="mb-2 block size-12 rounded-full"
                              style="background: oklch(var(--hue-l) var(--hue-c) {{ angle }})"></span>
                        <code class="text-xs text-fg-2">{{ angle }}°</code>
                    </li>
                {% endfor %}
            </ul>
            <p class="mt-3 max-w-prose text-sm text-fg-2">
                Lightness and chroma come from the theme, so every angle stays in the same family and is
                correct in both themes from one stored number.
            </p>
        </section>

        <section class="mb-12">
            <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-fg-2">Type</h2>
            <dl class="space-y-4">
                <div>
                    <dt class="text-xs text-fg-3">font-ui — interface</dt>
                    <dd class="font-ui text-lg">Kansai, spring 2025 — seven goshuin</dd>
                </div>
                <div>
                    <dt class="text-xs text-fg-3">font-jp — interface, Japanese</dt>
                    <dd class="font-jp text-lg">清水寺 · 伏見稲荷大社 · 東大寺 · 春日大社</dd>
                </div>
                <div>
                    <dt class="text-xs text-fg-3">font-brush — inside a goshuin only, never interface</dt>
                    <dd class="font-brush text-3xl">大悲閣 令和七年三月十四日</dd>
                </div>
            </dl>
        </section>

        <section class="mb-12">
            <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-fg-2">Elevation</h2>
            <div class="flex flex-wrap gap-4">
                <span class="rounded-2xl bg-tile px-6 py-5 text-sm shadow-card">shadow-card</span>
                <span class="rounded-2xl bg-tile px-6 py-5 text-sm shadow-lift">shadow-lift</span>
            </div>
        </section>

        <section class="mb-12">
            <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-fg-2">Layout and surfaces</h2>
            <div class="cols">
                <div class="stack">
                    {% embed 'App/_partials/_section.html.twig' with {title: 'A tile', aux: 'with a header'} %}
                        {% block content %}
                            <p class="text-sm text-fg-2">The surface every screen is made of. Padded variant.</p>
                        {% endblock %}
                    {% endembed %}
                    <div class="tile tile-flat p-5">
                        <p class="text-sm text-fg-2">The flat variant: no shadow, recessed ground.</p>
                    </div>
                </div>
                <div class="stack">
                    {% embed 'App/_partials/_section.html.twig' with {title: 'Facts', aux: 'empty rows are dropped'} %}
                        {% block content %}
                            {{ include('App/_partials/_kvs.html.twig', {rows: [
                                {label: 'Received at', value: '春日大社 · Kasuga-taisha', jp: true},
                                {label: 'On', value: '14 March 2025'},
                                {label: 'Price paid', value: null},
                                {label: 'Goshuin type', value: ''},
                            ]}) }}
                            <div class="mt-4">
                                {{ include('App/_partials/_pills.html.twig', {pills: [
                                    {text: 'March 2025', icon: 'cal', hot: true},
                                    {text: '7 goshuin'},
                                    {text: '関西 Kansai', jp: true},
                                    {text: null},
                                ]}) }}
                            </div>
                        {% endblock %}
                    {% endembed %}
                    {% embed 'App/_partials/_section.html.twig' with {title: 'Nothing to show'} %}
                        {% block content %}
                            {{ include('App/_partials/_kvs.html.twig', {rows: [
                                {label: 'Price paid', value: null},
                                {label: 'Notes', value: ''},
                            ]}) }}
                            <p class="text-sm text-fg-3">Above this line a key/value list was asked for with every value
                                empty. It emitted nothing — no labels, no dashes, no gap.</p>
                        {% endblock %}
                    {% endembed %}
                </div>
            </div>
        </section>

        <section class="mb-12">
            <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-fg-2">Dates and money</h2>
            <div class="cols">
                {% embed 'App/_partials/_section.html.twig' with {title: 'The same date, two languages'} %}
                    {% block content %}
                        {{ include('App/_partials/_kvs.html.twig', {rows: [
                            {label: 'en', value: '2025-03-14'|format_date(locale='en', pattern='d MMMM y')},
                            {label: 'fr', value: '2025-03-14'|format_date(locale='fr', pattern='d MMMM y')},
                        ]}) }}
                    {% endblock %}
                {% endembed %}
                {% embed 'App/_partials/_section.html.twig' with {title: 'Money follows its currency, not the interface'} %}
                    {% block content %}
                        {{ include('App/_partials/_kvs.html.twig', {rows: [
                            {label: '300 JPY, minor units', value: 300|money('JPY', 'fr')},
                            {label: '300 JPY, read in English', value: 300|money('JPY', 'en')},
                            {label: '500 EUR, minor units', value: 500|money('EUR', 'fr')},
                            {label: 'nothing at all', value: null|money('JPY')},
                        ]}) }}
                    {% endblock %}
                {% endembed %}
            </div>
        </section>

        <section>
            <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-fg-2">Controls, focus, hidden text</h2>
            <div class="flex flex-wrap items-center gap-3">
                {{ include('App/_partials/_button.html.twig', {label: 'Ordinary'}) }}
                {{ include('App/_partials/_button.html.twig', {label: 'With an icon', icon: 'edit'}) }}
                {{ include('App/_partials/_button.html.twig', {label: 'Primary', icon: 'plus', variant: 'primary'}) }}
                {{ include('App/_partials/_button.html.twig', {icon: 'trash', aria: 'Delete'}) }}
                {{ include('App/_partials/_button.html.twig', {label: 'A link that is a link', href: '#'}) }}
                <button type="button" class="cursor-pointer rounded-lg px-1.5 py-[3px] text-[13px] font-semibold text-accent-text hover:bg-accent-soft">Quiet action</button>
                <span class="sr">Visually hidden but read aloud</span>
            </div>
        </section>
    </main>
{% endblock %}
