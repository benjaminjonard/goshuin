{% extends 'base.html.twig' %}

{% block title %}{{ city.name }} · Goshuin{% endblock %}

{% block bar %}
    {% embed 'App/_partials/_bar.html.twig' with {
        title: city.name,
        kicker: [{label: 'label.cities'|trans, href: path('app_city_index')}],
    } %}
        {% block tools %}
            {{ include('App/_partials/_button.html.twig', {icon: 'edit', href: path('app_city_edit', {slug: city.slug}), aria: 'label.edit'|trans}) }}
            {{ include('App/_partials/_button.html.twig', {icon: 'trash', href: path('app_city_delete', {slug: city.slug}), aria: 'label.delete'|trans}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    <main class="page stack" data-controller="lightbox">
        <div class="grid gap-[clamp(12px,1.4vw,18px)]{{ city.photographFull ? ' grid-cols-2' }}">
            {% if city.photographFull %}
                <section class="tile stage">
                    <a href="{{ city.photograph|image }}" class="block" data-action="lightbox#open">
                        <img src="{{ city.photographFull|image }}" alt="{{ city.name }}" class="photograph">
                    </a>
                </section>
            {% endif %}

            <div class="{{ city.photographFull ? 'relative' }}">
                <div class="flex flex-col gap-[clamp(12px,1.4vw,18px)]{{ city.photographFull ? ' absolute inset-0' }}">
                    {{ include('App/_partials/_totals.html.twig', {totals: [
                        {
                            icon: 'prefecture',
                            value: city.prefecture ? city.prefecture.name : null,
                            label: 'label.prefecture',
                            href: city.prefecture ? path('app_prefecture_show', {slug: city.prefecture.slug}) : null,
                        },
                        {icon: 'pin', value: locations, label: 'label.stat_locations', href: path('app_location_index', {city: city.slug})},
                    ]}) }}

                    {% if city.notes is not empty %}
                        {% embed 'App/_partials/_section.html.twig' with {title: 'label.notes'|trans, class: 'flex min-h-0 flex-col'} %}
                            {% block content %}
                                <div class="min-h-0 overflow-y-auto text-[14.5px] leading-[1.75] text-fg-2">{{ city.notes|deities }}</div>
                            {% endblock %}
                        {% endembed %}
                    {% endif %}
                </div>
            </div>
        </div>

        {{ include('App/_partials/_visits.html.twig') }}

        {{ include('App/_partials/_gallery.html.twig', {photos: city.photos, title: 'label.photographs'|trans}) }}

        {% if city.photographFull or city.photos is not empty %}
            {{ include('App/_partials/_lightbox.html.twig') }}
        {% endif %}
    </main>
{% endblock %}
