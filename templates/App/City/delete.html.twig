{% extends 'base.html.twig' %}

{% block title %}{{ 'label.delete'|trans }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {
        kicker: [{label: 'label.cities'|trans, href: path('app_city_index')}],
        title: city.name,
    }) }}
{% endblock %}

{% block body %}
    {{ include('App/_partials/_delete.html.twig', {
        subject: city.name,
        back: path('app_city_show', {slug: city.slug}),
        referenced: 'error.city_referenced',
        confirm: 'label.delete_city',
    }) }}
{% endblock %}
