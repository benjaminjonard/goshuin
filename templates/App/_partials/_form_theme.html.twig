{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="grid gap-1.5{{ (' ' ~ row_attr.class|default(''))|trim ? ' ' ~ row_attr.class|default('') }}">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block location_widget %}
    {{ component('LocationCombobox', {name: full_name, id: id, selected: value}) }}
{% endblock %}

{% block cover_widget %}
    {% set stored = attr['data-cover'] ?? null %}
    <div class="grid gap-2" data-controller="upload">
        <label class="grid cursor-pointer place-items-center gap-1 rounded-2xl border border-dashed border-line-2 bg-tile-2 px-4 py-6 text-center hover:border-fg-3">
            {% if stored %}
                <img src="{{ stored|image(384) }}" alt="" class="mb-1 max-h-40 rounded-xl object-contain">
            {% else %}
                {{ include('App/_partials/_icon.html.twig', {name: 'img', class: 'text-fg-3'}) }}
            {% endif %}
            <strong class="text-[13.5px] font-semibold text-fg">{{ label|trans }}</strong>
            <span class="text-xs text-fg-3" data-upload-target="hint">{{ (stored ? 'label.replace_or_browse' : 'label.drop_or_browse')|trans }}</span>
            <input type="file" id="{{ id }}" name="{{ full_name }}" accept="image/jpeg,image/png,image/webp" class="sr"
                   data-upload-target="input" data-action="upload#chosen">
        </label>
        <span class="hidden h-1 overflow-hidden rounded-full bg-line-2" data-upload-target="track">
            <span class="block h-full w-0 bg-accent transition-[width]" data-upload-target="bar"></span>
        </span>
    </div>
{% endblock %}

{% block hue_widget %}
    <div class="grid gap-2.5" data-controller="hue">
        <div class="flex items-center gap-3.5">
            <span class="size-11 shrink-0 rounded-full hue-fill" data-hue-target="preview" style="--hue: {{ value }}" aria-hidden="true"></span>
            <span class="text-[13px] font-semibold tabular-nums text-fg-2" data-hue-target="value">{{ value }}°</span>
        </div>
        <input type="range" min="0" max="360" step="1"
               id="{{ id }}" name="{{ full_name }}" value="{{ value }}"
               class="h-3 w-full cursor-pointer appearance-none rounded-full hue-scale"
               data-hue-target="input"
               data-action="input->hue#paint">
    </div>
{% endblock %}

{% block yen_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' pl-10!')|trim}) %}
    <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-3.5 grid place-items-center text-fg-3" aria-hidden="true">
            {{- include('App/_partials/_icon.html.twig', {name: 'yen', small: true}) -}}
        </span>
        {{- block('form_widget_simple') -}}
    </div>
{% endblock %}

{% block checkbox_row %}
    <div class="grid gap-1.5{{ (' ' ~ row_attr.class|default(''))|trim ? ' ' ~ row_attr.class|default('') }}">
        <label class="flex cursor-pointer items-center gap-2.5">
            {{- form_widget(form) -}}
            <span class="text-[13.5px] font-medium leading-snug text-fg">{{ label|trans(label_translation_parameters, translation_domain) }}</span>
        </label>
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block checkbox_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' size-[17px] shrink-0 cursor-pointer rounded border-line-2 accent-accent')|trim}) %}
    {{- parent() -}}
{% endblock %}

{% block form_label %}
    {% if label is not same as(false) %}
        {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' text-[12.5px] font-semibold text-fg-2')|trim}) %}
        {{- parent() -}}
    {% endif %}
{% endblock %}

{% block form_widget_simple %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' w-full rounded-xl border border-line-2 bg-tile-2 px-3.5 py-2.5 text-[15px] text-fg hover:border-fg-3 focus-visible:border-accent focus-visible:bg-tile')|trim}) %}
    {{- parent() -}}
{% endblock %}

{% block textarea_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' w-full min-h-24 resize-y rounded-xl border border-line-2 bg-tile-2 px-3.5 py-2.5 text-[15px] leading-relaxed text-fg hover:border-fg-3 focus-visible:border-accent focus-visible:bg-tile')|trim}) %}
    {{- parent() -}}
{% endblock %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' w-full cursor-pointer rounded-xl border border-line-2 bg-tile-2 px-3.5 py-2.5 text-[15px] text-fg hover:border-fg-3 focus-visible:border-accent focus-visible:bg-tile')|trim}) %}
    {{- parent() -}}
{% endblock %}

{% block form_help %}
    {% if help is not empty %}
        <p class="text-xs leading-normal text-fg-3">{{ help|trans(help_translation_parameters, translation_domain) }}</p>
    {% endif %}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="grid gap-1">
            {% for error in errors %}
                <li class="text-xs font-semibold text-accent-text">{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
