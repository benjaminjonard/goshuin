<header class="sticky top-0 z-40 flex flex-wrap items-center gap-x-4 gap-y-2.5 border-b border-line
               bg-[color-mix(in_srgb,var(--color-bg)_88%,transparent)] px-[clamp(14px,2.6vw,30px)] py-[13px] backdrop-blur-[14px]">
    <a href="/" class="inline-flex items-center gap-2.5 rounded-xl py-[3px] pl-[3px] pr-[5px] no-underline text-fg group" aria-label="{{ 'label.brand'|trans }}">
        <span class="grid size-[34px] place-items-center rounded-[10px] bg-accent-soft" aria-hidden="true">
            <svg class="size-[22px] fill-accent" viewBox="0 0 32 32"><use href="#i-pli"/></svg>
        </span>
        <span class="text-base font-bold tracking-[-0.02em] group-hover:text-accent-text">Goshuin</span>
    </a>

    {% if title is defined %}
        <span class="mx-0.5 h-[26px] w-px bg-line-2" aria-hidden="true"></span>

        <div class="min-w-0 flex-auto">
            {% if kicker is defined and kicker is not empty %}
                <p class="text-xs font-semibold tracking-[0.02em] text-accent-text">
                    {%- for crumb in kicker -%}
                        {%- if not loop.first %} · {% endif -%}
                        {%- if crumb.href is defined -%}
                            <a href="{{ crumb.href }}" class="no-underline hover:underline">{{ crumb.label }}</a>
                        {%- else -%}
                            {{ crumb.label }}
                        {%- endif -%}
                    {%- endfor -%}
                </p>
            {% endif %}
            <h1 class="flex flex-wrap items-baseline gap-2.5 text-[clamp(18px,2.2vw,22px)] font-bold leading-tight tracking-[-0.02em]">
                {{ title }}
                {%- if jp is defined and jp is not empty %}
                    <em class="font-jp text-[0.82em] font-medium not-italic text-fg-2">{{ jp }}</em>
                {% endif %}
            </h1>
        </div>
    {% endif %}

    <div class="flex items-center gap-2 {{ title is defined ? '' : 'ml-auto' }}">
        {% block tools %}{% endblock %}

        {% if app.user %}
            <div class="relative" data-controller="menu">
                <button type="button"
                        class="grid size-[38px] cursor-pointer place-items-center rounded-full border border-line-2 bg-tile-2 text-[13px] font-bold tracking-[0.02em] text-fg-2 transition-colors hover:border-fg-3 hover:text-fg"
                        data-menu-target="button"
                        data-action="menu#toggle"
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-label="{{ 'label.account'|trans }}">{{ app.user.initials }}</button>

                <div class="absolute right-0 top-full mt-2 hidden min-w-[190px] overflow-hidden rounded-2xl border border-line bg-tile shadow-lift" data-menu-target="panel">
                    <p class="border-b border-line px-4 py-3">
                        <span class="block truncate text-[13.5px] font-semibold text-fg">{{ app.user.name }}</span>
                        <span class="block truncate text-xs text-fg-3">{{ app.user.email }}</span>
                    </p>
                    <a href="{{ path('app_location_index') }}" class="flex items-center gap-2.5 px-4 py-3 text-[13.5px] font-semibold text-fg no-underline hover:bg-tile-2">
                        {{ include('App/_partials/_icon.html.twig', {name: 'pin', small: true, class: 'text-fg-2'}) }}
                        {{ 'label.locations'|trans }}
                    </a>
                    <a href="{{ path('app_deity_index') }}" class="flex items-center gap-2.5 px-4 py-3 text-[13.5px] font-semibold text-fg no-underline hover:bg-tile-2">
                        {{ include('App/_partials/_icon.html.twig', {name: 'tag', small: true, class: 'text-fg-2'}) }}
                        {{ 'label.deities'|trans }}
                    </a>
                    <a href="{{ path('app_settings') }}" class="flex items-center gap-2.5 border-t border-line px-4 py-3 text-[13.5px] font-semibold text-fg no-underline hover:bg-tile-2">
                        {{ include('App/_partials/_icon.html.twig', {name: 'edit', small: true, class: 'text-fg-2'}) }}
                        {{ 'label.settings'|trans }}
                    </a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_user_index') }}" class="flex items-center gap-2.5 px-4 py-3 text-[13.5px] font-semibold text-fg no-underline hover:bg-tile-2">
                            {{ include('App/_partials/_icon.html.twig', {name: 'goshuincho', small: true, class: 'text-fg-2'}) }}
                            {{ 'label.users'|trans }}
                        </a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}" class="flex items-center gap-2.5 border-t border-line px-4 py-3 text-[13.5px] font-semibold text-fg no-underline hover:bg-tile-2">
                        {{ include('App/_partials/_icon.html.twig', {name: 'out', small: true, class: 'text-fg-2'}) }}
                        {{ 'label.sign_out'|trans }}
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</header>
