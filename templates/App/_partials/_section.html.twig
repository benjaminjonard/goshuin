<section class="tile tile-pad {{ class|default('') }}">
    <div class="mb-3.5 flex items-center justify-between gap-3.5">
        <h2 class="text-[12.5px] font-bold uppercase tracking-[0.05em] text-fg-2">{{ title }}</h2>
        {% block aux %}
            {% if aux is defined and aux is not empty %}
                <span class="text-[12.5px] tabular-nums text-fg-3">{{ aux }}</span>
            {% endif %}
        {% endblock %}
    </div>
    {% block content %}{% endblock %}
</section>
