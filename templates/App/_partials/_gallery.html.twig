{% if photos is not empty %}
    {% embed 'App/_partials/_section.html.twig' with {title: title, aux: photos|length} %}
        {% block content %}
            <ol class="gallery">
                {% for photo in photos %}
                    <li>
                        <figure class="relative">
                            <a href="{{ photo.image|image }}" class="block" data-action="lightbox#open">
                                <img src="{{ photo.imageCard|image }}" class="gallery-image"
                                     alt="{{ photo.label ?: 'label.photographs'|trans }}">
                            </a>
                            {% if photo.label %}
                                <figcaption class="shot-caption">{{ photo.label }}</figcaption>
                            {% endif %}
                        </figure>
                    </li>
                {% endfor %}
            </ol>
        {% endblock %}
    {% endembed %}
{% endif %}
