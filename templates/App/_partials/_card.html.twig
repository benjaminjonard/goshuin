<a href="{{ href }}"
   class="group grid content-start gap-2.5 rounded-[14px] border border-transparent p-1.5 no-underline hover:border-accent-line hover:bg-tile"
   {%- if hue|default(null) is not null %} style="--hue: {{ hue }}"{% endif %}>
    <figure class="shot">
        {% if image|default(null) %}
            <img src="{{ image|image }}" alt="" class="shot-image"
                 {%- if width|default(null) and height|default(null) %} width="{{ width }}" height="{{ height }}"{% endif %}>
        {% else %}
            <span class="shot-empty" aria-hidden="true">{{ include('App/_partials/_icon.html.twig', {name: icon}) }}</span>
        {% endif %}
    </figure>

    <h3 class="flex min-w-0 items-start justify-center gap-2 px-1 text-center text-[14.5px] font-bold leading-[1.3] tracking-[-0.02em] text-fg group-hover:text-accent-text">
        {%- if hue|default(null) is not null %}
            <span class="mt-[5px] size-2 shrink-0 rounded-full hue-fill" aria-hidden="true"></span>
        {% endif -%}
        <span class="min-w-0 line-clamp-2{{ jp|default(false) ? ' font-jp' }}">{{ title }}</span>
    </h3>

    {% if below|default(null) is not empty %}
        <span class="-mt-1.5 truncate px-1 pb-1 text-center text-xs text-fg-3">{{ below }}</span>
    {% endif %}
</a>
