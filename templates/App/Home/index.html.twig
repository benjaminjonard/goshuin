{% extends 'base.html.twig' %}

{% block title %}{{ 'label.home'|trans }} · Goshuin{% endblock %}

{% block bar %}
    {% embed 'App/_partials/_bar.html.twig' with {kicker: 'label.collection_of'|trans({'%name%': app.user.name}), title: 'label.home'|trans} %}
        {% block tools %}
            {{ include('App/_partials/_button.html.twig', {label: 'label.add_goshuincho'|trans, icon: 'plus', variant: 'primary', href: path('app_goshuincho_add')}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    <main class="mx-auto grid w-full max-w-[660px] gap-[clamp(12px,1.4vw,18px)] px-[clamp(14px,2.6vw,30px)] pt-[clamp(18px,5vw,64px)] pb-[clamp(34px,4vw,54px)]">
        <div class="tile px-[clamp(20px,2.6vw,38px)] py-[clamp(24px,3.6vw,44px)] text-center">
            <span class="mx-auto mb-5 grid size-[62px] place-items-center rounded-[18px] bg-accent-soft" aria-hidden="true">
                <svg class="size-10 fill-accent" viewBox="0 0 32 32"><use href="#i-torii"/></svg>
            </span>
            <h2 class="text-[clamp(22px,2.8vw,28px)] font-bold leading-tight tracking-[-0.025em]">{{ 'label.home_empty'|trans }}</h2>
            <div class="mt-6 flex flex-wrap justify-center gap-2.5">
                {{ include('App/_partials/_button.html.twig', {label: 'label.home_empty_cta'|trans, icon: 'plus', variant: 'primary', href: path('app_goshuincho_add')}) }}
            </div>
        </div>
    </main>
{% endblock %}
