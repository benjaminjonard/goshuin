{% extends 'base.html.twig' %}

{% block title %}{{ 'label.locations'|trans }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {title: 'label.locations'|trans}) }}
{% endblock %}

{% block body %}
    {{ include('App/_partials/_list.html.twig', {
        route: 'app_location_index',
        search: 'label.location_search',
        nothing: 'label.no_location_yet',
        noun: 'label.locations',
        back: 'label.all_locations',
        cards: locations|map(location => {
            href: path('app_location_show', {slug: location.slug}),
            image: location.photographCard,
            icon: 'pin',
            title: location.romanizedName,
            below: [
                location.japaneseName,
                location.city ? location.city.name : null,
                location.prefecture ? location.prefecture.name : null,
            ]|filter(part => part is not empty)|join(' · '),
        }),
    }) }}
{% endblock %}
