{% extends 'base.html.twig' %}

{% block title %}{{ 'label.delete'|trans }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {
        kicker: [{label: 'label.locations'|trans, href: path('app_location_index')}],
        title: location.romanizedName,
    }) }}
{% endblock %}

{% block body %}
    {{ include('App/_partials/_delete.html.twig', {
        subject: location.romanizedName,
        back: path('app_location_show', {slug: location.slug}),
        referenced: 'error.location_referenced',
        confirm: 'label.delete_location',
    }) }}
{% endblock %}
