{% extends 'base.html.twig' %}

{% block title %}{{ location.romanizedName }} · Goshuin{% endblock %}

{% block bar %}
    {% embed 'App/_partials/_bar.html.twig' with {
        title: location.romanizedName,
        jp: location.japaneseName,
        kicker: 'label.locations'|trans,
        back: path('app_location_index'),
    } %}
        {% block tools %}
            {% if is_granted('ROLE_ADMIN') %}
                {{ include('App/_partials/_button.html.twig', {icon: 'edit', href: path('app_location_edit', {id: location.id}), aria: 'label.edit'|trans}) }}
                {{ include('App/_partials/_button.html.twig', {icon: 'trash', href: path('app_location_delete', {id: location.id}), aria: 'label.delete'|trans}) }}
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    {% set coordinates = location.hasCoordinates ? '%.4f, %.4f'|format(location.latitude, location.longitude) : null %}

    <main class="page stack">
        {% set record = [
            {label: 'label.name'|trans, value: location.japaneseName, jp: true},
            {label: 'label.romanized_name'|trans, value: location.romanizedName},
            {label: 'label.location_type'|trans, value: location.type ? ('label.' ~ location.type.value)|trans : null},
            {label: 'label.locality'|trans, value: location.locality},
            {label: 'label.prefecture'|trans, value: location.prefecture},
            {label: 'label.address'|trans, value: location.address},
            {label: 'label.coordinates'|trans, value: coordinates},
        ]|filter(row => row.value is not empty) %}

        {% if location.photographFull or record is not empty %}
            <div class="grid gap-[clamp(12px,1.4vw,18px)]{{ location.photographFull and record is not empty ? ' grid-cols-[auto_minmax(0,1fr)]' }}">
                {% if location.photographFull %}
                    <section class="tile stage">
                        <img src="{{ location.photographFull|image }}" alt="{{ location.romanizedName }}"
                             class="h-[clamp(260px,28vw,440px)] w-auto max-w-full rounded-xl object-contain shadow-lift">
                    </section>
                {% endif %}

                {% if record is not empty %}
                    {% embed 'App/_partials/_section.html.twig' with {title: 'label.information'|trans} %}
                        {% block content %}
                            {{ include('App/_partials/_kvs.html.twig', {rows: record}) }}
                        {% endblock %}
                    {% endembed %}
                {% endif %}
            </div>
        {% endif %}

        {% if location.hasCoordinates %}
            {% embed 'App/_partials/_section.html.twig' with {title: 'label.map'|trans} %}
                {% block content %}
                    <div data-controller="map"
                         data-map-mode-value="numbered"
                         data-map-tiles-value="{{ map_tiles }}"
                         data-map-attribution-value="{{ map_attribution }}"
                         data-map-markers-value="{{ [{
                             latitude: location.latitude,
                             longitude: location.longitude,
                             label: location.romanizedName,
                         }]|json_encode }}">
                        <div class="minimap h-[260px]" data-map-target="canvas"></div>
                        <ul class="sr">
                            <li>{{ location.romanizedName }} · {{ coordinates }}</li>
                        </ul>
                    </div>
                {% endblock %}
            {% endembed %}
        {% endif %}

        {% if location.notes is not empty %}
            {% embed 'App/_partials/_section.html.twig' with {title: 'label.notes'|trans} %}
                {% block content %}
                    <div class="text-[14.5px] leading-[1.75] text-fg-2">{{ location.notes|nl2br }}</div>
                {% endblock %}
            {% endembed %}
        {% endif %}

        {% if location.photos is not empty %}
            <div data-controller="lightbox">
                {{ include('App/_partials/_gallery.html.twig', {photos: location.photos, title: 'label.photographs'|trans}) }}

                <dialog class="lightbox" data-lightbox-target="frame"
                        data-action="click->lightbox#dismiss close->lightbox#cleared">
                    <img data-lightbox-target="image" alt=""
                         class="block max-h-[94vh] max-w-full rounded-xl shadow-lift">
                    <button type="button" aria-label="{{ 'label.close'|trans }}"
                            class="absolute right-2.5 top-2.5 grid size-9 cursor-pointer place-items-center rounded-full border border-line-2 bg-tile text-fg-2 shadow-card hover:border-fg-3 hover:text-fg"
                            data-action="lightbox#close">
                        {{- include('App/_partials/_icon.html.twig', {name: 'close', small: true}) -}}
                    </button>
                </dialog>
            </div>
        {% endif %}
    </main>
{% endblock %}
