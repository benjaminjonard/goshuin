{% if this.geocoderAvailable %}
    <div class="grid gap-1.5">
        <label class="text-[12.5px] font-semibold text-fg-2" for="{{ id }}-address">{{ 'label.address_search'|trans }}</label>
        <input type="text" id="{{ id }}-address" data-model="debounce(1000)|address" value="{{ address }}"
               class="w-full rounded-xl border border-line-2 bg-tile px-3.5 py-2.5 text-[15px] text-fg focus-visible:border-accent"
               placeholder="{{ 'label.address_placeholder'|trans }}">

        <p class="hidden overflow-hidden rounded-xl border border-line bg-tile px-3.5 py-2.5 text-[13px] text-fg-3"
           data-loading="model(address)|removeClass(hidden)" role="status">
            <span class="mr-2 inline-block size-4 animate-spin rounded-full border-2 border-line-2 border-t-accent align-[-3px]" aria-hidden="true"></span>
            {{ 'label.searching'|trans }}
        </p>

        {% if this.searchable %}
            <div class="grid overflow-hidden rounded-xl border border-line bg-tile" role="listbox" data-loading="model(address)|addClass(hidden)">
                <span class="grid">
                {% if this.failed %}
                    <p class="flex items-start gap-2.5 px-3.5 py-2.5 text-[13px] text-accent-text" role="alert">
                        {{ include('App/_partials/_icon.html.twig', {name: 'info', small: true, class: 'mt-px'}) }}
                        {{ 'error.geocoder'|trans }}
                    </p>
                {% elseif this.places is empty %}
                    <p class="px-3.5 py-2.5 text-[13px] text-fg-3">{{ 'label.no_result'|trans }}</p>
                {% else %}
                {% for place in this.places %}
                    <button type="button" role="option" aria-selected="false"
                            class="grid cursor-pointer gap-0.5 px-3.5 py-2.5 text-left hover:bg-tile-2"
                            data-action="live#action"
                            data-live-action-param="usePlace"
                            data-live-place-name-param="{{ place.name }}"
                            data-live-japanese-name-param="{{ place.japaneseName }}"
                            data-live-locality-param="{{ place.locality }}"
                            data-live-prefecture-param="{{ place.prefecture }}"
                            data-live-address-param="{{ place.address }}"
                            data-live-latitude-param="{{ place.latitude }}"
                            data-live-longitude-param="{{ place.longitude }}">
                        <span class="truncate text-sm font-semibold text-fg">{{ place.name }}</span>
                        <span class="truncate text-xs text-fg-3"><span class="font-jp">{{ place.japaneseName }}</span>{{ place.japaneseName and place.address ? ' · ' }}{{ place.address }}</span>
                    </button>
                {% endfor %}
                {% endif %}
                </span>
            </div>
        {% endif %}
    </div>
{% endif %}

{{ form_errors(form) }}
{{ form_row(form.romanizedName) }}

{% if this.duplicates is not empty %}
    <p class="flex items-start gap-2.5 rounded-xl border border-accent-line bg-accent-soft px-3.5 py-3 text-[12.5px] leading-relaxed text-accent-text" role="alert">
        {{ include('App/_partials/_icon.html.twig', {name: 'info', small: true, class: 'mt-px'}) }}
        <span>{{ 'message.location_duplicate'|trans({'%count%': this.duplicates|length}) }}</span>
    </p>
{% endif %}

<div class="grid items-start gap-3.5 sm:grid-cols-2">
    {{ form_row(form.japaneseName) }}
    {{ form_row(form.locality) }}
</div>

<div class="grid items-start gap-3.5 sm:grid-cols-2">
    {{ form_row(form.prefecture) }}
    {{ form_row(form.type) }}
</div>

{{ form_row(form.address) }}

<div data-controller="map"
     data-map-mode-value="picker"
     data-map-tiles-value="{{ map_tiles }}"
     data-map-attribution-value="{{ map_attribution }}"
     data-map-latitude-value="{{ form.latitude.vars.value|default(0) ?: 0 }}"
     data-map-longitude-value="{{ form.longitude.vars.value|default(0) ?: 0 }}"
     class="grid gap-3.5">
    <div class="grid items-start gap-3.5 sm:grid-cols-2">
        {{ form_row(form.latitude, {attr: {'data-map-target': 'latitude'}}) }}
        {{ form_row(form.longitude, {attr: {'data-map-target': 'longitude'}}) }}
    </div>

    <div class="minimap h-[260px]" data-map-target="canvas" data-live-ignore aria-label="{{ 'label.place_on_map'|trans }}"></div>
    <p class="text-xs text-fg-3">{{ 'label.place_on_map'|trans }}</p>
</div>

{% if form.photographFile is defined %}
    <div class="grid gap-1.5" data-live-ignore>
        {{ form_widget(form.photographFile, {attr: {'data-cover': form.vars.data.photographCard}}) }}
        {{ form_errors(form.photographFile) }}
        {{ form_row(form.removePhotograph) }}
    </div>

    <div data-live-ignore>
        {{ include('App/_partials/_photos.html.twig', {scope: 'place', label: 'label.photographs', photos: form.vars.data.photos}) }}
    </div>
{% endif %}

{{ form_row(form.notes) }}
{{ form_rest(form) }}
