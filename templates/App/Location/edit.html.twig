{% extends 'base.html.twig' %}

{% block title %}{{ location.romanizedName }} · Goshuin{% endblock %}

{% block bar %}
    {{ include('App/_partials/_bar.html.twig', {
        kicker: [{label: 'label.locations'|trans, href: path('app_location_index')}],
        title: location.romanizedName,
    }) }}
{% endblock %}

{% block body %}
    <main class="page mx-auto grid w-full max-w-[560px] gap-[clamp(12px,1.4vw,18px)]">
        <form method="post" enctype="multipart/form-data" class="grid gap-[clamp(12px,1.4vw,18px)]">
            {{ component('LocationForm', {form: form, location: location, id: 'location'}) }}

            <div class="mt-1 flex justify-end gap-2.5">
                {{ include('App/_partials/_button.html.twig', {label: 'label.cancel'|trans, href: path('app_location_show', {id: location.id})}) }}
                {{ include('App/_partials/_button.html.twig', {label: 'label.save'|trans, variant: 'primary', type: 'submit', name: 'location_submit'}) }}
            </div>
        </form>
    </main>
{% endblock %}
