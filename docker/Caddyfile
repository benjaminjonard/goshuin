{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	order php_server before file_server
	order php before file_server
}

{$CADDY_EXTRA_CONFIG}

{$FRANKENPHP_SERVER_NAME:localhost} {
	root * public/
	encode zstd gzip

	header {
	    Referrer-Policy no-referrer
	    Permissions-Policy interest-cohort=()
	    Strict-Transport-Security "max-age=31536000; includeSubdomains; preload;"
	    X-Content-Type-Options nosniff
	    X-Frame-Options Deny
	}

	# Images are static files with unguessable names, served without touching PHP.
	# The trade this makes is recorded in FR-4 of the PRD.
	@immutable path /build/* /uploads/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	request_body {
	    max_size {$UPLOAD_MAX_FILESIZE:100M}
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
