{
    "name": "benjaminjonard/goshuin",
    "description": "Self-hosted manager for a collection of goshuin and goshuincho",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "3.3.2",
        "doctrine/doctrine-migrations-bundle": "4.0.1",
        "doctrine/orm": "3.7.3",
        "gedmo/doctrine-extensions": "3.22.2",
        "stof/doctrine-extensions-bundle": "1.15.3",
        "symfony/asset": "8.1.0",
        "symfony/console": "8.1.8",
        "symfony/dotenv": "8.1.6",
        "symfony/expression-language": "8.1.6",
        "symfony/flex": "2.11.0",
        "symfony/form": "8.1.8",
        "symfony/framework-bundle": "8.1.8",
        "symfony/http-client": "8.1.8",
        "symfony/intl": "8.1.5",
        "symfony/mime": "8.1.7",
        "symfony/monolog-bundle": "4.1.0",
        "symfony/rate-limiter": "8.1.6",
        "symfony/reprise": "1.3.0",
        "symfony/routing": "8.1.8",
        "symfony/runtime": "8.1.0",
        "symfony/security-bundle": "8.1.8",
        "symfony/translation": "8.1.5",
        "symfony/twig-bundle": "8.1.7",
        "symfony/uid": "8.1.8",
        "symfony/ux-live-component": "^3.4",
        "symfony/validator": "8.1.8",
        "symfony/yaml": "8.1.8",
        "twig/extra-bundle": "3.29.0",
        "twig/intl-extra": "3.30.0",
        "twig/twig": "3.30.0"
    },
    "require-dev": {
        "brianium/paratest": "7.24.1",
        "dama/doctrine-test-bundle": "8.6.0",
        "phpunit/phpunit": "13.4.0",
        "symfony/browser-kit": "8.1.5",
        "symfony/css-selector": "8.1.6",
        "symfony/debug-bundle": "8.1.0",
        "symfony/web-profiler-bundle": "8.1.8",
        "zenstruck/foundry": "2.13.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "docker": false,
            "require": "8.1.*"
        },
        "runtime": {
            "class": "Symfony\\Component\\Runtime\\SymfonyRuntime"
        }
    },
    "scripts": {
        "test:phpunit": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/phpunit"
        ],
        "test:paratest": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/paratest --runner=WrapperRunner"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
